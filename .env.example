NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_MODE=prisma
DATABASE_URL=postgresql://char_code:change-me@postgres:5432/char_code
JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
CHAR_CODE_HOSTED_URL=https://char-code.example

# Kanal powiadomien. Bez SMTP_HOST i SMTP_FROM alerty bezpieczenstwa
# pozostaja w bazie ze statusem PENDING i nie sa dostarczane.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=alerty@char-code.example
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true wymusza SMTPS; dla portu 465 wlaczane automatycznie.
# SMTP_INSECURE_TLS=true wylacza weryfikacje certyfikatu - zabronione w produkcji.

# Privileged migration identity only; never use as runtime DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://migration-owner:change-me@postgres:5432/char_code
